$graphite: #101419;
$surface: #192129;
$border: #34434E;
$foreground: #DCE3EA;
$cyan: #55C5D2;
$success: #79CDA0;
$warning: #E4BC72;
$violet: #B59AF0;

Screen { background: $graphite; color: $foreground; }
#header { background: $surface; border: solid $border; height: auto; min-height: 3; }
#brand { width: auto; min-width: 8; height: auto; padding: 0 1; color: $cyan; }
#session { width: 1fr; height: auto; padding: 0 1; color: $cyan; }
#header Button { min-width: 5; width: auto; }
#body { height: 1fr; }
#sidebar { width: 24; height: 1fr; background: $surface; padding: 0 1; border-right: solid $border; }
#sidebar.compact { display: none; }
#sidebar Button { width: 100%; margin: 0; text-align: left; height: 2; border: none; }
#sidebar .selected { background: $border; color: $cyan; }
.nav-group { color: $cyan; text-style: bold; padding: 1 0 0 0; }
#pages { width: 1fr; height: 1fr; padding: 0 1; }
ContentSwitcher, TabbedContent, TabPane, VerticalScroll { height: 1fr; }
#status-bar { height: auto; min-height: 1; background: $surface; padding: 0 1; }
.heading { text-style: bold; color: $cyan; height: auto; margin-bottom: 1; }
.panel { background: $surface; border: solid $border; padding: 0 1; height: auto; }
.master-detail { height: 1fr; }
.master-detail DataTable, .master-detail Tree { width: 3fr; }
.master-detail VerticalScroll { width: 2fr; }
DataTable, Tree { height: 1fr; min-height: 3; background: $graphite; }
DataTable > .datatable--header { background: $surface; color: $cyan; }
DataTable > .datatable--cursor { background: $border; color: $cyan; }
.actions { height: auto; layout: grid; grid-size: 2; grid-columns: 1fr 1fr; grid-rows: auto; }
.actions Button { width: 100%; min-width: 1; }
.actions Input { width: 100%; }
#case-tools, #case-tools-modules { height: auto; }
#case-tools Input, #case-tools-modules Input { width: 1fr; }
#case-tools Select, #case-tools-modules Select { width: 18; }
Button { background: $surface; border: solid $border; color: $foreground; }
Button:hover, Button:focus { border: solid $cyan; color: $cyan; }
Button.-primary { background: $cyan; color: $graphite; border: solid $cyan; }
Button:disabled { color: $foreground 40%; border: solid $border; }
Input, Select { background: $surface; border: tall $border; }
Input:focus, Select:focus { border: tall $cyan; }
#case-detail, #mount-summary, #entity-config, #module-errors { height: auto; padding: 0 1; }
#workspace-tabs { height: 1fr; }
.quick-group { height: auto; margin-bottom: 1; padding: 0 1; border: solid $border; background: $surface; }
.quick-group Button { width: 100%; margin-bottom: 0; height: 3; }
#storage-group .heading { color: $success; }
#acquisition-group .heading { color: $violet; }
.destructive { color: $warning; }
ModalScreen { align: center middle; background: $graphite 75%; }
.dialog { width: 75%; max-height: 90%; height: auto; border: solid $cyan; background: $surface; padding: 1; }
.operation { width: 94%; height: 92%; }
#operation-log { height: 1fr; background: $graphite; }
#case-workspace { height: 1fr; }
#disk-tree { height: auto; min-height: 6; max-height: 14; }
#operator-table { height: 8; }
#entity-logo-preview { height: auto; }
#manager-actions { grid-size: 3; grid-columns: 1fr 1fr 1fr; }
