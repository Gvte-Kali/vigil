#!/usr/bin/python3 -I
"""Privileged mount of one administrator-approved, already-RO ext4 partition."""
import ctypes
import fcntl
import os
import re
import stat
import struct
import sys
import syslog
from pathlib import Path

TARGET = Path("/investigation")
APPROVAL = Path("/etc/vigil/approved-partition")
RUN = Path("/run/vigil-mount")
BY_ID = Path("/dev/disk/by-id")
FLAGS = os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK
BLOCK_RO_GET = 0x125e
BY_ID_PARTITION = re.compile(r"[A-Za-z0-9._:+-]+-part[1-9][0-9]*")
MOUNT_FLAGS = 1 | 2 | 4 | 8  # MS_RDONLY | MS_NOSUID | MS_NODEV | MS_NOEXEC
LIBC = ctypes.CDLL(None, use_errno=True)


def check_root_owned(info):
    if info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("expected a root-owned path without group or other write access")


def approved_source():
    check_root_owned(APPROVAL.parent.lstat())
    if APPROVAL.parent.is_symlink():
        raise ValueError("approval directory must not be a symbolic link")
    with os.fdopen(os.open(APPROVAL, FLAGS), "rb") as stream:
        info = os.fstat(stream.fileno())
        check_root_owned(info)
        if not stat.S_ISREG(info.st_mode):
            raise ValueError("approval must be a regular file")
        name = stream.read(256).decode("ascii").strip()
    if not BY_ID_PARTITION.fullmatch(name):
        raise ValueError("approval must contain one /dev/disk/by-id partition name")
    return BY_ID / name


def mounts():
    records = []
    with open("/proc/self/mountinfo", encoding="utf-8") as stream:
        for line in stream:
            entry, _, filesystem = line.partition(" - ")
            fields = entry.split()
            if fields[4] == str(TARGET) or fields[4].startswith(f"{TARGET}/"):
                records.append((fields[0], fields[2], fields[4], fields[5].split(","),
                                filesystem.split()[0]))
    return records


def require_ro_partition(descriptor):
    info = os.fstat(descriptor)
    if not stat.S_ISBLK(info.st_mode):
        raise ValueError("approved source is not a block device")
    device = f"{os.major(info.st_rdev)}:{os.minor(info.st_rdev)}"
    node = Path("/sys/dev/block", device).resolve(strict=True)
    if not (node / "partition").is_file():
        raise ValueError("approved source is not a partition")
    if (node.parent / "ro").read_text().strip() != "1":
        raise ValueError("parent device is not read-only")
    result = fcntl.ioctl(descriptor, BLOCK_RO_GET, bytes(4))
    if struct.unpack("i", result)[0] != 1:
        raise ValueError("partition is not read-only")
    return device


def checked_call(result):
    if result != 0:
        code = ctypes.get_errno()
        raise OSError(code, os.strerror(code))


def mount_partition(receipt):
    if receipt.exists() or mounts():
        raise ValueError("investigation is occupied or needs administrator reconciliation")
    source = approved_source()
    with os.fdopen(os.open(source.resolve(strict=True), FLAGS), "rb") as block:
        target = os.open(TARGET, FLAGS | os.O_DIRECTORY)
        try:
            check_root_owned(os.fstat(target))
            if os.listdir(target):
                raise ValueError("investigation directory must be empty")
            device = require_ro_partition(block.fileno())
            if source.stat().st_rdev != os.fstat(block.fileno()).st_rdev or mounts():
                raise ValueError("source or mount state changed")
            checked_call(LIBC.mount(
                f"/proc/self/fd/{block.fileno()}".encode(),
                f"/proc/self/fd/{target}".encode(), b"ext4",
                ctypes.c_ulong(MOUNT_FLAGS), b"noload",
            ))
            current = mounts()
            if (len(current) != 1 or current[0][1:3] != (device, str(TARGET))
                    or current[0][4] != "ext4"
                    or not {"ro", "nosuid", "nodev", "noexec"}.issubset(current[0][3])):
                raise ValueError("mount could not be verified; administrator reconciliation required")
            receipt.write_text(f"{current[0][0]} {device}\n", encoding="ascii")
            print(f"{TARGET}: {source} ({device}), ext4 ro")
        finally:
            os.close(target)


def unmount_partition(receipt):
    expected = receipt.read_text(encoding="ascii").strip()
    current = mounts()
    if (len(current) != 1 or current[0][2] != str(TARGET)
            or " ".join(current[0][:2]) != expected):
        raise ValueError("mount was not created by Vigil or has nested mounts")
    checked_call(LIBC.umount2(os.fsencode(TARGET), 0))
    receipt.unlink()
    print(f"{TARGET}: unmounted")


def main():
    if os.geteuid() != 0 or len(sys.argv) != 2 or sys.argv[1] not in {"mount", "unmount"}:
        print("usage: vigil-mount {mount|unmount} (administrator authorization required)",
              file=sys.stderr)
        return 2
    operation = sys.argv[1]
    caller = os.environ.get("SUDO_UID", "0")
    caller = caller if caller.isascii() and caller.isdigit() else "unknown"
    receipt = RUN / "receipt"
    try:
        RUN.mkdir(mode=0o700, exist_ok=True)
        info = RUN.lstat()
        check_root_owned(info)
        if not stat.S_ISDIR(info.st_mode):
            raise ValueError("invalid runtime directory")
        with (RUN / "lock").open("a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            syslog.syslog(syslog.LOG_NOTICE, f"vigil-mount {operation} uid={caller} start")
            {"mount": mount_partition, "unmount": unmount_partition}[operation](receipt)
    except (OSError, ValueError) as error:
        syslog.syslog(syslog.LOG_ERR, f"vigil-mount {operation} uid={caller} failed: {error}")
        print(error, file=sys.stderr)
        return 1
    syslog.syslog(syslog.LOG_NOTICE, f"vigil-mount {operation} uid={caller} complete")
    return 0


if __name__ == "__main__":
    sys.exit(main())
