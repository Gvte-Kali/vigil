#!/usr/bin/python3 -I
"""Authorize a live Vigil session and write-protect new physical block devices."""
import fcntl
import json
import os
import re
import select
import subprocess
import stat
import struct
import sys
import syslog
import tempfile
import time
from contextlib import contextmanager
from pathlib import Path

SESSIONS = Path("/run/vigil-hotplug")
PID = re.compile(r"[1-9][0-9]{0,9}")
BLOCK_RO_SET = 0x125D
BLOCK_RO_GET = 0x125E
BLOCK_DISKSEQ_GET = 0x80081280


@contextmanager
def state_lock():
    SESSIONS.mkdir(mode=0o755, exist_ok=True)
    info = SESSIONS.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("invalid session directory")
    with (SESSIONS / "lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def ledger():
    path = SESSIONS / "devices"
    path.mkdir(mode=0o700, exist_ok=True)
    return path


def process_identity(pid):
    if not PID.fullmatch(pid):
        raise ValueError("invalid process ID")
    process = Path("/proc") / pid
    info = (process / "stat").read_text()
    fields = info.rsplit(")", 1)[1].split()
    if fields[0] == "Z":
        raise ProcessLookupError(pid)
    return f"{process.stat().st_uid} {fields[19]}"


def write_report(pid, identity, report):
    directory = SESSIONS / "reports"
    directory.mkdir(mode=0o755, exist_ok=True)
    info = directory.lstat()
    if not stat.S_ISDIR(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022:
        raise ValueError("invalid report directory")
    for previous in directory.glob("*.json"):
        try:
            stale = previous.stat().st_mtime < time.time() - 86400
        except FileNotFoundError:
            continue
        if stale:
            previous.unlink(missing_ok=True)
    with tempfile.NamedTemporaryFile(dir=directory, mode="w", delete=False) as stream:
        temporary = Path(stream.name)
        try:
            json.dump(report, stream)
            stream.flush()
            os.fchmod(stream.fileno(), 0o644)
            temporary.replace(directory / f"{pid}-{identity.split()[1]}.json")
        finally:
            temporary.unlink(missing_ok=True)


def cleanup():
    with state_lock():
        if active():
            return {"status": "other_session", "devices": []}
        devices = restore_devices()
    # The udev rule itself acquires state_lock. Wait only after releasing it.
    pending = [row for row in devices if row["state"] == "restored"]
    if pending:
        try:
            subprocess.run(["/usr/bin/udevadm", "settle", "--timeout=5"], check=True, timeout=6)
        except (OSError, subprocess.SubprocessError) as error:
            for row in pending:
                row.update(state="unverified", detail=str(error))
        else:
            for row in pending:
                try:
                    result = subprocess.run(
                        ["/usr/bin/udevadm", "info", "--query=property", "--path", row["node"]],
                        capture_output=True, text=True, check=True, timeout=3,
                    )
                    properties = result.stdout.splitlines()
                    if "VIGIL_HOTPLUG_OWNS_IGNORE=1" in properties:
                        row.update(state="unverified", detail="Vigil udev exclusion still present")
                    row["os_ignored"] = "UDISKS_IGNORE=1" in properties
                except (OSError, subprocess.SubprocessError) as error:
                    row.update(state="unverified", detail=str(error))
    with state_lock():
        if active():
            return {"status": "other_session", "devices": []}
        for row in pending:
            path = row["_path"]
            if (row["state"] == "restored" and path.is_file()
                    and json.loads(path.read_text()) == row["_record"]):
                path.unlink()
    for row in devices:
        row.pop("node", None)
        row.pop("_path", None)
        row.pop("_record", None)
    return {"status": "complete", "devices": devices}


def activate(pid):
    identity = process_identity(pid)
    if identity.split()[0] != os.environ.get("SUDO_UID"):
        raise ValueError("session process does not belong to the sudo caller")
    if not hasattr(os, "pidfd_open"):
        raise ValueError("Vigil hotplug requires Linux pidfd support")
    watcher = os.pidfd_open(int(pid))
    try:
        with state_lock():
            if process_identity(pid) != identity:
                raise ValueError("session process changed")
            path = SESSIONS / pid
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_TRUNC | os.O_NOFOLLOW, 0o644)
            with os.fdopen(fd, "w") as token:
                token.write(identity + "\n")
                os.fchmod(token.fileno(), 0o644)
            try:
                write_report(pid, identity, {"status": "pending"})
                child = os.fork()
            except (OSError, ValueError) as error:
                path.unlink(missing_ok=True)
                try:
                    write_report(pid, identity, {"status": "error", "detail": str(error)})
                except (OSError, ValueError):
                    pass
                raise
        if child:
            return
        try:
            os.setsid()
            with open("/dev/null", "r+b", buffering=0) as null:
                for descriptor in (0, 1, 2):
                    os.dup2(null.fileno(), descriptor)
            poller = select.poll()
            poller.register(watcher, select.POLLIN)
            poller.poll()
            write_report(pid, identity, cleanup())
        except Exception as error:
            syslog.syslog(syslog.LOG_ERR, f"vigil-hotplug: session cleanup: {error}")
            try:
                write_report(pid, identity, {"status": "error", "detail": str(error)})
            except (OSError, ValueError):
                pass
        finally:
            os._exit(0)
    finally:
        os.close(watcher)


def active():
    if not SESSIONS.is_dir():
        return False
    found = False
    for path in SESSIONS.iterdir():
        if not PID.fullmatch(path.name):
            continue
        try:
            found_session = path.read_text().strip() == process_identity(path.name)
        except (OSError, ValueError, IndexError):
            found_session = False
        if found_session:
            found = True
        else:
            path.unlink(missing_ok=True)
    return found


def device_identity(fd, major, minor):
    info = os.fstat(fd)
    if not stat.S_ISBLK(info.st_mode) or (os.major(info.st_rdev), os.minor(info.st_rdev)) != (major, minor):
        raise ValueError("block identity changed")
    return struct.unpack("Q", fcntl.ioctl(fd, BLOCK_DISKSEQ_GET, bytes(8)))[0]


def mode(fd):
    return struct.unpack("i", fcntl.ioctl(fd, BLOCK_RO_GET, bytes(4)))[0]


def protect(device, major, minor):
    with state_lock():
        if not active():
            return
        print("VIGIL_HOTPLUG=1")
        try:
            major, minor = int(major), int(minor)
            node = Path(f"/sys/dev/block/{major}:{minor}").resolve(strict=True)
            fd = os.open(device, os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC)
            try:
                sequence = device_identity(fd, major, minor)
                record = ledger() / f"{major}:{minor}"
                if not record.exists() or json.loads(record.read_text())["sequence"] != sequence:
                    record.write_text(json.dumps({
                        "device": device, "sequence": sequence, "mode": mode(fd),
                        "major": major, "minor": minor, "node": str(node),
                        "partition": (node / "partition").exists(),
                    }))
                if mode(fd) != 1:
                    fcntl.ioctl(fd, BLOCK_RO_SET, struct.pack("i", 1))
                if mode(fd) != 1:
                    raise ValueError("kernel did not confirm RO")
                print("VIGIL_HOTPLUG_RO=1")
            finally:
                os.close(fd)
        except (OSError, ValueError) as error:
            print("VIGIL_HOTPLUG_RO=0")
            print(f"vigil-hotplug: {device}: {error}", file=sys.stderr)


def restore_device(record):
    node = Path(f"/sys/dev/block/{record['major']}:{record['minor']}")
    if not node.exists() or node.resolve() != Path(record["node"]):
        return "absent"
    fd = os.open(record["device"], os.O_RDONLY | os.O_NONBLOCK | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_EXCL)
    try:
        if device_identity(fd, record["major"], record["minor"]) != record["sequence"]:
            return "absent"
        # Devices already RO before Vigil are never forced RW.
        if record["mode"] == 0 and mode(fd) != 0:
            fcntl.ioctl(fd, BLOCK_RO_SET, struct.pack("i", 0))
        if mode(fd) != record["mode"]:
            raise ValueError("kernel did not confirm the original block mode")
    finally:
        os.close(fd)
    subprocess.run(["/usr/bin/udevadm", "trigger", "--action=change", record["node"]],
                   check=True, timeout=5)
    return "restored"


def restore_devices():
    records = [(path, json.loads(path.read_text())) for path in ledger().iterdir()]
    results = []
    # Restore whole disks first, so inherited RO does not hide a partition's mode.
    for path, record in sorted(records, key=lambda entry: entry[1]["partition"]):
        row = {"device": record["device"], "node": record.get("node"), "mode": record.get("mode"),
               "_path": path, "_record": record}
        try:
            row["state"] = restore_device(record)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            row.update(state="error", detail=str(error))
            syslog.syslog(syslog.LOG_ERR, f"vigil-hotplug: {record['device']}: {error}")
        else:
            if row["state"] == "absent":
                path.unlink()
        results.append(row)
    return results


def main():
    if os.geteuid() != 0:
        return 1
    try:
        match sys.argv[1:]:
            case ["activate", pid]:
                activate(pid)
            case ["recover"]:
                print(json.dumps(cleanup()))
            case ["status"]:
                with state_lock():
                    print(f"VIGIL_HOTPLUG_ACTIVE={int(active())}")
            case ["protect", device, major, minor]:
                protect(device, major, minor)
            case _:
                return 2
    except (OSError, ValueError, IndexError) as error:
        print(f"vigil-hotplug: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
